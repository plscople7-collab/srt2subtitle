{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "srt2subtitle-v02",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "srt2subtitle",
      "database_id": "d54e6aeb-568e-4f3c-8594-51c83a6ea2b1"
    }
  ]
}
