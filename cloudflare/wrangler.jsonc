{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "srt2subtitle-v02",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
